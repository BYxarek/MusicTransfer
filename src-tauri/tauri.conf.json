{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MusicTransfer Alpha",
  "version": "2.3.0-alpha.6",
  "identifier": "app.musictransfer.desktop.alpha",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "MusicTransfer Alpha",
      "width": 1020,
      "height": 740,
      "minWidth": 600,
      "minHeight": 500
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; media-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGQjFBMEZFMzMzODFGRDAKUldUUUh6Z3ovcUN4Yi9YMUE1YXlOWFRkMUVoTFZ1QThxdlFaQ0FiTGNvL1JRdGdpT1hFWGtZSzMK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
